{
  "$schema": "./node_modules/wrangler/config-schema.json",
  "name": "novaproxy",
  "main": "worker.js",
  "compatibility_date": "2026-07-30",
  "compatibility_flags": ["nodejs_compat"],
  "d1_databases": [
    { "binding": "DB","database_id": "23610f99-ab2f-46a7-9548-c76a7d1809dd","database_name": "novaproxydb" }
  ],
  "kv_namespaces": [
    { "binding": "KV","id": "fa7636c3f2544963ba5cf90ee6387129" }
  ],
  "workers_dev": true,
  "preview_urls": true,
  "observability": {
    "enabled": true,
    "logs": {
      "enabled": true,
      "head_sampling_rate": 1,
      "invocation_logs": true
    },
    "traces": {
      "enabled": true,
      "head_sampling_rate": 0.01
    }
  }
}
